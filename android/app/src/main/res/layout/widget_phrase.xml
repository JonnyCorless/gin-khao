<?xml version="1.0" encoding="utf-8"?>
<!-- Phrase of the day. Plain views only: home-screen widgets support a small set. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/w_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="60dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_label"
            android:textAllCaps="true"
            android:textColor="#E2C25A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_th"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_rom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#C9CFF5"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/w_en"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E6E8F5"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/w_play"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/widget_play_bg"
        android:contentDescription="@string/widget_play"
        android:src="@drawable/ic_widget_play" />
</FrameLayout>
