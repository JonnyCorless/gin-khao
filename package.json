{
  "name": "gin-khao",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "ginkhao": {
    "minApk": 100
  },
  "scripts": {
    "dev": "vite",
    "content": "python tools/build_content.py",
    "bundle-content": "node tools/bundle_content.mjs",
    "build": "npm run bundle-content && tsc --noEmit && vite build",
    "sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
