{
  "name": "solanasmash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:server": "npm run dev -w @solanasmash/server",
    "dev:client": "npm run dev -w @solanasmash/client",
    "test": "npm test -w @solanasmash/sim && npm test -w @solanasmash/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.0",
    "vite": "^6.4.4",
    "@types/node": "^22.0.0"
  }
}
