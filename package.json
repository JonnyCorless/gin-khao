    "sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^7.1.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/kanit": "^5.3.0",
    "@fontsource/noto-sans-thai-looped": "^5.3.0",
    "preact": "^10.29.8",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
